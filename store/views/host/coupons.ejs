<!doctype html>
<html lang="en">

	<%- include('../partials/head') %>

	<body>

		<!-- Start Header/Navigation -->
		<%- include('../partials/header2') %>
		<!-- End Header/Navigation -->

		<!-- Start Hero Section -->
		<div class="hero">
			<div class="container">
				<div class="row justify-content-between">
					<div class="col-lg-5">
						<div class="intro-excerpt">
							<h1>Manage Coupons</h1>
							<p class="mb-4">Create, view, and disable discount coupons for the Furni store.</p>
						</div>
					</div>
					<div class="col-lg-7">
					</div>
				</div>
			</div>
		</div>
		<!-- End Hero Section -->

		<div class="untree_co-section">
			<div class="container">
				<div class="row">
					<!-- Add Coupon Form -->
					<div class="col-md-4 mb-5">
						<div class="bg-light p-4 rounded border shadow-sm">
							<h3 class="h5 text-black mb-4">Create New Coupon</h3>
							<form action="/host/addCoupon" method="POST">
								<div class="form-group mb-3">
									<label class="text-black" for="code">Coupon Code</label>
									<input type="text" class="form-control" style="text-transform: uppercase;" id="code" name="code" placeholder="e.g. SUMMER30" required>
								</div>
								
								<div class="form-group mb-3">
									<label class="text-black" for="discountType">Discount Type</label>
									<select class="form-control" id="discountType" name="discountType" required>
										<option value="percentage">Percentage (%)</option>
										<option value="flat">Flat Amount (₹)</option>
									</select>
								</div>

								<div class="form-group mb-3">
									<label class="text-black" for="discountValue">Discount Value</label>
									<input type="number" min="0" step="any" class="form-control" id="discountValue" name="discountValue" placeholder="Value (e.g. 10 or 500)" required>
								</div>

								<div class="form-group mb-3">
									<label class="text-black" for="minCartValue">Minimum Cart Value (₹)</label>
									<input type="number" min="0" value="0" class="form-control" id="minCartValue" name="minCartValue" placeholder="Minimum cart total" required>
								</div>

								<div class="form-group mb-4">
									<div class="form-check">
										<input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="true" checked>
										<label class="form-check-label text-black" for="isActive">
											Active (Enabled)
										</label>
									</div>
								</div>

								<button type="submit" class="btn btn-black btn-block py-3">Add Coupon</button>
							</form>
						</div>
					</div>

					<!-- Coupons List -->
					<div class="col-md-8">
						<div class="p-4 rounded border bg-white shadow-sm">
							<h3 class="h5 text-black mb-4">Existing Coupons</h3>
							
							<% if (coupons && coupons.length > 0) { %>
								<div class="table-responsive">
									<table class="table table-hover">
										<thead>
											<tr>
												<th>Code</th>
												<th>Discount</th>
												<th>Min Cart</th>
												<th>Status</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											<% coupons.forEach(coupon => { %>
												<tr>
													<td>
														<strong class="text-black"><%= coupon.code %></strong>
													</td>
													<td>
														<%= coupon.discountType === 'percentage' ? coupon.discountValue + '%' : '₹' + coupon.discountValue %>
													</td>
													<td>₹ <%= coupon.minCartValue %></td>
													<td>
														<span class="badge <%= coupon.isActive ? 'bg-success' : 'bg-secondary' %>">
															<%= coupon.isActive ? 'Active' : 'Inactive' %>
														</span>
													</td>
													<td>
														<form action="/host/deleteCoupon" method="POST" onsubmit="return confirm('Are you sure you want to delete coupon <%= coupon.code %>?');">
															<input type="hidden" name="couponId" value="<%= coupon._id %>">
															<button type="submit" class="btn btn-danger btn-sm text-white">Delete</button>
														</form>
													</td>
												</tr>
											<% }) %>
										</tbody>
									</table>
								</div>
							<% } else { %>
								<div class="text-center py-5 text-muted">
									<p class="mb-0">No coupons found. Create your first coupon using the form on the left.</p>
								</div>
							<% } %>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Start Footer Section -->
		<%- include('../partials/footer') %>
		<!-- End Footer Section -->	

		<script src="/js/bootstrap.bundle.min.js"></script>
		<script src="/js/tiny-slider.js"></script>
		<script src="/js/custom.js"></script>
	</body>
</html>
