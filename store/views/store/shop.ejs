<!doctype html>
<html lang="en">

	<%- include('../partials/head'); %>

	<body>

		<!-- Start Header/Navigation -->
		<%- include('../partials/header') %>
		<!-- End Header/Navigation -->

		<!-- Start Hero Section -->
			<div class="hero">
				<div class="container">
					<div class="row justify-content-between">
						<div class="col-lg-5">
							<div class="intro-excerpt">
								<h1>Shop</h1>
								<p class="mb-4">Buy the best furniture for your home.Here you get all products from our store.</p>
								
							</div>
						</div>
						<div class="col-lg-7">
							<div class="hero-img-wrap">
								<img src="/images/product-2c.png" class="img-fluid" width="50%">
							</div>
						</div>
						
					</div>
				</div>
			</div>
		<!-- End Hero Section -->

		
		

		<div class="untree_co-section product-section before-footer-section">
		    <div class="container">
				
		      	<div class="row">

					<!-- Start Column 1 -->
					<div class="col-md-12 col-lg-3 mb-5 mb-lg-0">
						<h2 class="mb-4 section-title">All Products From Store, Which you Love.</h2>
						<p class="mb-4">Explore our wide range of high-quality products, carefully selected to meet all your style, comfort, and everyday needs.</p>
						<h4 class="product-item">-></h4>
					</div> 
					<!-- End Column 1 -->

					<% products.forEach( product => { %>

		      		<!-- Start Column 1 -->
					<div class="col-12 col-md-4 col-lg-3 mb-5">
						<a class="product-item" href="/product/<%= product._id %>">
							<img src="/images/product-2.png" class="img-fluid product-thumbnail">
							<h3 class="product-title"><%= product.name %></h3>
							<strong class="product-price"><%= product.price %></strong>
						</a>
					</div> 
					<!-- End Column 1 -->

					<% }) %>

		      	</div>
		    </div>
		</div>


		<!-- Start Footer Section -->
		<%- include('../partials/footer') %>
		<!-- End Footer Section -->	


		<script src="/js/bootstrap.bundle.min.js"></script>
		<script src="/js/tiny-slider.js"></script>
		<script src="/js/custom.js"></script>
	</body>

</html>
