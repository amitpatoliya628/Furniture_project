<!doctype html>
<html lang="en">

	<%- include('../partials/head') %>

	<body>

		<!-- Start Header/Navigation -->
		<%- include('../partials/header') %>
		<!-- End Header/Navigation -->

		<div class="untree_co-section before-footer-section">
            <div class="container">
              <div class="row mb-5">
                <div class="col-md-12">
                  <h2 class="text-black">My Wishlist</h2>
                  <p class="text-muted">Products you saved for later.</p>
                </div>
              </div>

              <div class="row mb-5">
                <div class="col-md-12">
                  <div class="site-blocks-table">
                    <table class="table">
                      <thead>
                        <tr>
                          <th class="product-thumbnail">Image</th>
                          <th class="product-name">Product</th>
                          <th class="product-price">Price</th>
                          <th class="product-add">Add To Cart</th>
                          <th class="product-remove">Remove</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if(wishlistProducts && wishlistProducts.length > 0){ %>
                          <% wishlistProducts.forEach(product => { %>
                          <tr>
                            <td class="product-thumbnail">
                              <img src="/<%= product.image %>" alt="<%= product.name %>" class="img-fluid">
                            </td>

                            <td class="product-name">
                              <h2 class="h5 text-black"><%= product.name %></h2>
                              <form action="/productDetails" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <button type="submit" class="btn btn-link p-0 text-decoration-none">View Details</button>
                              </form>
                            </td>

                            <td class="product-price">
                              ₹ <%= product.price %>
                            </td>

                            <td>
                              <form action="/addToCart" method="post">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <button type="submit" class="btn btn-outline-dark btn-sm">Add To Cart</button>
                              </form>
                            </td>

                            <td>
                              <form action="/removeFromWishlist" method="post">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <button type="submit" class="btn btn-black btn-sm">X</button>
                              </form>
                            </td>
                          </tr>
                          <% }) %>
                        <% } else { %>
                          <tr>
                            <td colspan="5" class="text-center py-5">
                              <h2 class="text-black">Your Wishlist is Empty!</h2>
                              <p class="text-muted mb-4">Save products you love and find them here anytime.</p>
                              <p><a href="/shop" class="btn btn-black btn-lg py-3 btn-block">Browse Products</a></p>
                            </td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
        </div>

        <!-- Start Footer Section -->
        <%- include('../partials/footer') %>
        <!-- End Footer Section -->

        <script src="/js/bootstrap.bundle.min.js"></script>
        <script src="/js/tiny-slider.js"></script>
  </body>
</html>
